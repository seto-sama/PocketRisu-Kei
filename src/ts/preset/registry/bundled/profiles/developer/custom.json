      },
      {
        "key": "top_k",
        "widget": "slider",
        "visibility": "basic",
        "layout": "row",
        "disableable": true,
        "group": "generation",
        "order": 3
      },
      {
        "key": "top_p",
        "widget": "slider",
        "visibility": "basic",
        "layout": "row",
        "disableable": true,
        "fixed": 2,
        "group": "generation",
        "order": 4
      },
      {
        "key": "min_p",
        "widget": "slider",
        "visibility": "basic",
        "layout": "row",
        "disableable": true,
        "fixed": 2,
        "group": "generation",
        "order": 5
      },
      {
        "key": "top_a",
        "widget": "slider",
